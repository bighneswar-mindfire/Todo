{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec openspec:*)",
      "Bash(pnpm --filter:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git worktree:*)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(pnpm --filter @todo/backend migrate:*)",
      "Bash(npx prisma migrate:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/*/.env)",
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(git commit:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node .claude/hooks/block-dangerous.mjs" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/save-context.mjs" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node .claude/hooks/format-file.mjs" }] }
    ]
  }
}
